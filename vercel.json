{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/webinars", "destination": "https://www.soothsayeranalytics.ai/webinars" },
    { "source": "/webinars/:path*", "destination": "https://www.soothsayeranalytics.ai/webinars/:path*" },
    { "source": "/digital-competency", "destination": "https://www.soothsayeranalytics.ai/digital-competency" },
    { "source": "/responsible-ai", "destination": "https://www.soothsayeranalytics.ai/responsible-ai" },

    { "source": "/case-studies", "destination": "https://soothsayeranalytics.com/case-studies" },
    { "source": "/case-studies/:path+", "destination": "https://www.soothsayeranalytics.ai/case-studies/:path+" },

    { "source": "/about", "destination": "https://www.soothsayeranalytics.ai/soothsayer-new/about" },
    { "source": "/soothsayer-new/:path+", "destination": "https://www.soothsayeranalytics.ai/soothsayer-new/:path+" },
    { "source": "/uae/:path+", "destination": "https://www.soothsayeranalytics.ai/uae/:path+" },

    { "source": "/:path+", "destination": "https://www.soothsayeranalytics.ai/:path+" }
  ]
}
